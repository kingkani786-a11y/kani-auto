# Optional — journal persists to Supabase when set, in-memory otherwise
CAT_SUPABASE_URL=
CAT_SUPABASE_SERVICE_KEY=

# Signal engine
CAT_CONFIDENCE_THRESHOLD=65

# Lock CORS to your frontend in production
CAT_FRONTEND_ORIGIN=*

# Secure login (V4): when set, all devices must unlock with this password
CAT_APP_PASSWORD=

# Portfolio risk defaults
CAT_CAPITAL=1000000
CAT_RISK_PER_TRADE_PCT=1.0
